<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <solid android:color="#191919" />
            <corners android:radius="5dp" />
            <stroke
                android:width="1dp"
                android:color="#3A3A3A"
                android:dashGap="3dp"
                android:dashWidth="4dp" />
        </shape>
    </item>
</layer-list>