<?xml version="1.0" encoding="utf-8"?>
<!-- 大回车的上半部分：外侧（上方）圆角，与下半部分接缝处保持直角，两半拼起来是连体异形键。
     与 bg_ax_key_enter_bottom 的 inset 对齐，接缝处各留 0，避免看出缝隙。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <solid android:color="#2B3138" />
            <corners
                android:topLeftRadius="5dp"
                android:topRightRadius="5dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
