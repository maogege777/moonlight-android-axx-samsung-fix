<?xml version="1.0" encoding="utf-8"?>
<!-- 大回车的下半部分：接缝处（上方）直角，外侧（下方）圆角，与 bg_ax_key_enter_top 拼成连体键。
     右侧与上半部分右边缘对齐，左侧比上半部分窄，形成异形台阶。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="0dp">
        <shape>
            <solid android:color="#2B3138" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="5dp"
                android:bottomRightRadius="5dp" />
        </shape>
    </item>
</layer-list>
