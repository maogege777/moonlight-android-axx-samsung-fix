<?xml version="1.0" encoding="utf-8"?>
<!--
    数字键盘 v7：数字区与「修饰键 + 方向键」组左右互换
    ├─ G1 左手区   (weight 88)    Esc / 中键 / 左键 / 右键
    ├─ G2 功能键区 (weight 224)   Shift Win PgUp / Ctrl Alt PgDn / ScrLk Home ↑ End / Del ← ↓ →
    ├─ G3 数字区   (weight 255)   NumLk ÷ × ⌫ / 7 8 9 − / 4 5 6 + / 1 2 3 Enter / 0(双格) .
    └─ G4 右列     (weight 150)   : \ + 滚轮 / 触摸板
    组间间距统一 30dp（3 处共 90dp，接近原 88dp），各块宽度与按键尺寸基本不变，触摸板 x 位置不变。
    按键背景 drawable、tag、字号一律沿用原值，未改任何配色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:orientation="horizontal"
    android:padding="3dp">

    <!-- ==================== G1 左手区 ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="88"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="111"
            android:text="Esc"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ax_key_num"
            android:gravity="center"
            android:tag="mouse_2"
            android:text="中键"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ax_key_num"
            android:gravity="center"
            android:tag="mouse_1"
            android:text="左键"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ax_key_num"
            android:gravity="center"
            android:tag="mouse_3"
            android:text="右键"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 功能键：4 列（修饰键各 1.5 列 + 方向键 1 列） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:layout_weight="224">
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="59"
            android:text="Shift"
            android:textColor="@android:color/white"
            android:textSize="11sp" />            <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="117"
            android:text="Win"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="92"
            android:text="PgUp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="113"
            android:text="Ctrl"
            android:textColor="@android:color/white"
            android:textSize="11sp" />            <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="57"
            android:text="Alt"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="93"
            android:text="PgDn"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="116"
            android:text="ScrLk"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="122"
            android:text="Home"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_alpha"
            android:gravity="center"
            android:tag="19"
            android:text="↑"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="123"
            android:text="End"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_mod"
            android:gravity="center"
            android:tag="112"
            android:text="Del"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_alpha"
            android:gravity="center"
            android:tag="21"
            android:text="←"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_alpha"
            android:gravity="center"
            android:tag="20"
            android:text="↓"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_key_alpha"
            android:gravity="center"
            android:tag="22"
            android:text="→"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>
    </LinearLayout>

    <!-- ==================== G2 数字区 ==================== -->
    <LinearLayout
        android:id="@+id/lv_digitpad"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_weight="255"
        android:orientation="vertical">

        <!-- 行1：NumLk ÷ × ⌫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_mod"
                android:gravity="center"
                android:tag="143"
                android:text="NumLk"
                android:textColor="@android:color/white"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_sym"
                android:gravity="center"
                android:tag="154"
                android:text="÷"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_sym"
                android:gravity="center"
                android:tag="155"
                android:text="×"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_mod"
                android:gravity="center"
                android:tag="67"
                android:text="⌫"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 行2：7 8 9 − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_alpha"
                android:gravity="center"
                android:tag="151"
                android:text="7"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_alpha"
                android:gravity="center"
                android:tag="152"
                android:text="8"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_alpha"
                android:gravity="center"
                android:tag="153"
                android:text="9"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_sym"
                android:gravity="center"
                android:tag="156"
                android:text="−"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 行3：4 5 6 + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_alpha"
                android:gravity="center"
                android:tag="148"
                android:text="4"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_alpha"
                android:gravity="center"
                android:tag="149"
                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_alpha"
                android:gravity="center"
                android:tag="150"
                android:text="6"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_sym"
                android:gravity="center"
                android:tag="157"
                android:text="+"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 行4+行5：1 2 3 / 0(双格) .  + Enter（跨两行） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <!-- 数字列 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">

                <!-- 行4：1 2 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ax_key_alpha"
                        android:gravity="center"
                        android:tag="145"
                        android:text="1"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ax_key_alpha"
                        android:gravity="center"
                        android:tag="146"
                        android:text="2"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ax_key_alpha"
                        android:gravity="center"
                        android:tag="147"
                        android:text="3"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 行5：0(双格) . -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:background="@drawable/bg_ax_key_alpha"
                        android:gravity="center"
                        android:tag="144"
                        android:text="0"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ax_key_alpha"
                        android:gravity="center"
                        android:tag="158"
                        android:text="."
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Enter：右下角，跨两行 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ax_key_mod"
                android:gravity="center"
                android:tag="66"
                android:text="Enter"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右列：上半区左侧新增 : / \ 两个键，右侧滚轮（宽度减半、靠右）；下半触摸板 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="150"
        android:orientation="vertical">

        <!-- 上半区：高度 = 行1 + 行2，左右各占一半 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <!-- 左半：: (角标 ;) 与 \ (角标 |)，每行一个 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_ax_key_sym"
                        android:gravity="center"
                        android:tag="1001"
                        android:text=":"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|right"
                        android:layout_marginRight="8dp"
                        android:layout_marginTop="4dp"
                        android:text=";"
                        android:textColor="#8CA0BC"
                        android:textSize="9sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_ax_key_sym"
                        android:gravity="center"
                        android:tag="73"
                        android:text="\\"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|right"
                        android:layout_marginRight="8dp"
                        android:layout_marginTop="4dp"
                        android:text="|"
                        android:textColor="#8CA0BC"
                        android:textSize="9sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- 右半：滚轮上下，宽度是原来的一半，靠右对齐 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mouse_up"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ax_key_num"
                    android:gravity="center"
                    android:text="滚轮⬆"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/mouse_down"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ax_key_num"
                    android:gravity="center"
                    android:text="滚轮⬇"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <com.limelight.ui.gamemenu.TouchPadView
            android:id="@+id/fv_keyboard_touch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@drawable/bg_ax_touchpad" />
    </LinearLayout>
</LinearLayout>
